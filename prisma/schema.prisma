generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountTarget {
  WHOLE_SUBSCRIPTION
  SPECIFIC_PRODUCT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  passwordHash        String               @map("password_hash")
  role                Role                 @default(CUSTOMER)
  isActive            Boolean              @default(true) @map("is_active")
  resetToken          String?              @map("reset_token")
  resetTokenExpiry    DateTime?            @map("reset_token_expiry")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  subscriptions       Subscription[]
  invoices            Invoice[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Product {
  id            String                  @id @default(uuid())
  name          String
  type          String                  @default("Software")
  salesPrice    Float                   @default(0.0) @map("sales_price")
  costPrice     Float                   @default(0.0) @map("cost_price")
  notes         String?
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  variants      ProductVariant[]
  subLines      SubscriptionLine[]
  invoiceLines  InvoiceLine[]
  templateLines QuotationTemplateLine[]
  discounts     DiscountRule[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String?  // e.g. "brand"
  value      String?  // e.g. "Odoo"
  name       String?  // e.g. "Odoo Brand"
  extraPrice Float    @default(0.0) @map("extra_price") // e.g. +560.0
  createdAt  DateTime @default(now()) @map("created_at")

  subLines   SubscriptionLine[]

  @@map("product_variants")
}

model Plan {
  id            String              @id @default(uuid())
  name          String
  cost          Float               @default(0.0) @map("price")
  frequency     BillingFrequency    @default(MONTHLY) @map("billing_period")
  minQuantity   Int                 @default(1) @map("min_quantity")
  startDate     DateTime?           @map("start_date")
  endDate       DateTime?           @map("end_date")
  autoClose     Boolean             @default(true) @map("auto_close")
  canCloseEarly Boolean             @default(true) @map("closable")
  canPause      Boolean             @default(true) @map("pausable")
  canRenew      Boolean             @default(true) @map("renewable")
  status        String              @default("ACTIVE") // ACTIVE, CLOSED, PAUSED
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  subscriptions Subscription[]
  templates     QuotationTemplate[]

  @@map("plans")
}

model QuotationTemplate {
  id           String                  @id @default(uuid())
  name         String
  validityDays Int                     @default(30)
  planId       String?
  plan         Plan?                   @relation(fields: [planId], references: [id])
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  lines        QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  quantity   Int               @default(1)
  unitPrice  Float             @default(0.0)
}

model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique // e.g. "SUB-1001"
  customerId         String
  customer           User               @relation(fields: [customerId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  nextBillingDate    DateTime
  lastBilledDate     DateTime?
  paymentTerms       String             @default("Immediate")
  discountCode       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lines              SubscriptionLine[]
  invoices           Invoice[]
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int             @default(1)
  unitPrice      Float           @default(0.0)
  taxRate        Float           @default(0.0) // percentage e.g. 10.0
  amount         Float           @default(0.0)
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique // e.g. "INV-1001"
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  periodStart    DateTime?
  periodEnd      DateTime?
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  subtotal       Float         @default(0.0)
  taxAmount      Float         @default(0.0)
  discountAmount Float         @default(0.0)
  totalAmount    Float         @default(0.0)
  notes          String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([subscriptionId, periodStart])
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  taxRate     Float    @default(0.0)
  amount      Float    @default(0.0)
}

model TaxRule {
  id             String   @id @default(uuid())
  name           String   // e.g. "VAT 10%", "Sales Tax 5%"
  ratePercentage Float    @default(0.0) @map("percentage")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("taxes")
}

model DiscountRule {
  id                String         @id @default(uuid())
  code              String?        @unique
  name              String
  type              DiscountType   @default(PERCENTAGE)
  value             Float          @default(0.0) // e.g. 15 for 15% or 50.0 for flat 50
  minPurchaseAmount Float?         @map("min_purchase")
  minQuantity       Int?           @map("min_quantity")
  startDate         DateTime?      @map("start_date")
  endDate           DateTime?      @map("end_date")
  usageLimit        Int?           @default(100) @map("usage_limit")
  timesUsed         Int            @default(0) @map("used_count")
  targetType        DiscountTarget @default(WHOLE_SUBSCRIPTION) @map("applies_to")
  targetProductId   String?        @map("product_id")
  targetProduct     Product?       @relation(fields: [targetProductId], references: [id])
  createdAt         DateTime       @default(now()) @map("created_at")

  @@map("discounts")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method      PaymentMethod @default(BANK_TRANSFER)
  amount      Float         @default(0.0)
  paymentDate DateTime      @default(now())
  note        String?
  createdAt   DateTime      @default(now())
}

// Atomic counters for document numbers (INV-0001, SUB-0001). See src/lib/sequence.ts
model Sequence {
  name  String @id
  value Int
}
